# Telegram credentials from my.telegram.org and @BotFather
API_ID=123456
API_HASH=replace_with_api_hash
BOT_TOKEN=123456:replace_with_bot_token
OWNER_ID=123456789
OWNER_USERNAME=your_username

# MongoDB connection
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=file_store_bot

# Public HTTPS URL for Telegram Web Apps and signed file links
WEB_URL=https://your-domain.example
DOMAIN=https://your-domain.example

# Generate two independent random values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_at_least_32_random_characters
FLASK_SECRET_KEY=replace_with_another_32_random_characters
ADMIN_PASSWORD=use_a_long_unique_password

# Optional settings
START_PHOTO=
START_CAPTION=Welcome {first} to Ultra File Store Pro
LOG_CHANNEL_ID=
LOG_TO_FILE=false
PORT=8000
WORKERS=2
DEBUG=false
